# Variables de entorno para ejecución local (renombrar a .env)

# Credenciales de Dropbox
DROPBOX_APP_KEY=tu_app_key_aqui
DROPBOX_APP_SECRET=tu_app_secret_aqui
DROPBOX_REFRESH_TOKEN=tu_refresh_token_aqui
EXPECTED_DROPBOX_EMAIL=tu_email@ejemplo.com
DROPBOX_ROOT=/SKUs

# Google Sheets
GSHEET_URL=https://docs.google.com/spreadsheets/d/TU_SHEET_ID/edit
SHEET_NAME=CATALOGO
COL_SKU=SKU
COL_NAME=Name
COL_PRICE=Price
COL_EXTRA=Marca

# Google Service Account (opcional si el Sheet no es público)
# Ruta a tu archivo json o json en string
# GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json
