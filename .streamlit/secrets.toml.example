# Ejemplo de configuración para Streamlit Cloud o local (.streamlit/secrets.toml)

DROPBOX_APP_KEY = "tu_app_key"
DROPBOX_APP_SECRET = "tu_app_secret"
DROPBOX_REFRESH_TOKEN = "tu_refresh_token"
EXPECTED_DROPBOX_EMAIL = "tu_email@ejemplo.com"
DROPBOX_ROOT = "/SKUs"

GSHEET_URL = "https://docs.google.com/spreadsheets/d/TU_SHEET_ID/edit"
SHEET_NAME = "CATALOGO"
COL_SKU = "SKU"
COL_NAME = "Name"
COL_PRICE = "Price"
COL_EXTRA = "Marca"
